{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aproar-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_ENV": "homologacao"
  },
  "keep_vars": true,
  "triggers": {"crons": ["0 */12 * * *"]}
}
